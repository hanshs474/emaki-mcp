{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-07-09/server.schema.json",
  "name": "io.github.hanshs474/emaki-mcp",
  "description": "Generate Seedance 2.5 / 2.0 video and AI images on emaki.ai from any MCP client.",
  "repository": {
    "url": "https://github.com/hanshs474/emaki-mcp",
    "source": "github"
  },
  "version": "0.1.0",
  "websiteUrl": "https://emaki.ai/",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "emaki-mcp",
      "version": "0.1.0",
      "transport": { "type": "stdio" },
      "environmentVariables": [
        { "name": "EMAKI_API_KEY", "description": "API key from https://emaki.ai/settings/apikeys", "isRequired": true, "isSecret": true }
      ]
    }
  ]
}
